{
  "permission-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|sed_file|notebook_execution",
        "hooks": [
          {
            "command": "node \"/root/self-bot/.agents/gatekeeper.js\"",
            "timeout": 130
          }
        ]
      }
    ]
  }
}